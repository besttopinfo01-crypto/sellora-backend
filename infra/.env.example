# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env file.

# --- Domain ---
# The subdomain n8n will live on, e.g. n8n.sellora.ai
# Point a DNS A record at this VPS's IP before starting Caddy, or TLS
# issuance will fail.
N8N_HOST=n8n.sellora.ai

# Used by Caddy for Let's Encrypt renewal/expiry notices, not shown publicly.
LETSENCRYPT_EMAIL=you@sellora.ai

# --- Timezone for cron/schedule-trigger nodes (e.g. the feed poller) ---
TIMEZONE=America/New_York

# --- Postgres (n8n's own internal database — separate from the Supabase
# project that holds business/seller data) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_with_a_long_random_value
POSTGRES_DB=n8n

# --- n8n credential encryption key ---
# Generate once with: openssl rand -base64 32
# Back this up somewhere outside the VPS. If it's lost, every stored
# credential (including, later, seller Amazon refresh tokens) becomes
# permanently undecryptable — there is no recovery path.
N8N_ENCRYPTION_KEY=replace_with_output_of_openssl_rand_-base64_32
