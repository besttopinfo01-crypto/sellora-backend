    {
      "parameters": {
        "jsCode": "const submissionGate = $('Submission Gate').first().json;\nconst validationRow = $input.first().json;\n\nif (!validationRow || !validationRow.decision) {\n  return [{ json: {\n    status: 'BLOCKED',\n    gate: 'VALIDATION_GATE',\n    reason: 'NO_VALIDATION_RECORD',\n    request_id: submissionGate.request_id,\n    message: 'No validation result found for this request. Run the request through Workflow 01 first.'\n  }}];\n}\n\nif (validationRow.decision === 'BLOCKED') {\n  return [{ json: {\n    status: 'BLOCKED',\n    gate: 'VALIDATION_GATE',\n    reason: 'HARD_BLOCKS_EXIST',\n    request_id: submissionGate.request_id,\n    message: 'This request has hard blocks and cannot be submitted. Fix the issues and revalidate.',\n    validation_decision: validationRow.decision\n  }}];\n}\n\nconst hardBlocks = Array.isArray(validationRow.hard_blocks_json)\n  ? validationRow.hard_blocks_json\n  : (validationRow.hard_blocks_json ? [validationRow.hard_blocks_json] : []);\n\nif (hardBlocks.length > 0) {\n  return [{ json: {\n    status: 'BLOCKED',\n    gate: 'VALIDATION_GATE',\n    reason: 'HARD_BLOCKS_EXIST',\n    request_id: submissionGate.request_id,\n    message: 'Hard blocks exist in the validation result. Cannot submit.',\n    hard_blocks: hardBlocks\n  }}];\n}\n\nreturn [{ json: {\n  status: 'VALIDATION_GATE_PASSED',\n  request_id: submissionGate.request_id,\n  validation_decision: validationRow.decision\n}}];"
