    {
      "parameters": {
        "jsCode": "const submissionGate = $('Submission Gate').first().json;\nconst approvalRow = $input.first().json;\n\nif (!approvalRow || approvalRow.approval_status !== 'APPROVED_FOR_PAYLOAD_PREVIEW') {\n  return [{ json: {\n    status: 'BLOCKED',\n    gate: 'APPROVAL_GATE',\n    reason: 'APPROVAL_REQUIRED',\n    request_id: submissionGate.request_id,\n    message: 'This request has not been approved for payload preview. Complete the manual approval process in Workflow 04 before submitting.',\n    current_approval_status: approvalRow ? approvalRow.approval_status : 'no approval record found'\n  }}];\n}\n\nconst allConfirmations = \n  approvalRow.confirm_same_product_family === true &&\n  approvalRow.confirm_no_review_manipulation === true &&\n  approvalRow.confirm_understands_risk === true;\n\nif (!allConfirmations) {\n  return [{ json: {\n    status: 'BLOCKED',\n    gate: 'APPROVAL_GATE',\n    reason: 'MISSING_CONFIRMATIONS',\n    request_id: submissionGate.request_id,\n    message: 'One or more required approval confirmations are missing. All four confirmations must be true before submission.',\n    confirm_same_product_family: approvalRow.confirm_same_product_family,\n    confirm_no_review_manipulation: approvalRow.confirm_no_review_manipulation,\n    confirm_understands_risk: approvalRow.confirm_understands_risk\n  }}];\n}\n\nreturn [{ json: {\n  status: 'APPROVAL_GATE_PASSED',\n  request_id: submissionGate.request_id,\n  approved_by: approvalRow.approved_by,\n  approved_at: approvalRow.approved_at\n}}];"
