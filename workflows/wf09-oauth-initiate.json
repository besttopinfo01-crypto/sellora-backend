      "parameters": {
        "jsCode": "const rawInput = $input.first().json;\nconst body = rawInput.body ? rawInput.body : rawInput;\n\nif (!body.seller_id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MISSING_SELLER_ID',\n    message: 'seller_id is required to start an Amazon authorization.'\n  }}];\n}\n\n// This IS the actual CSRF/replay defense, not a cosmetic identifier.\n// Two prior attempts using actual crypto both failed in this specific\n// n8n sandbox: require('crypto') is blocked, and the global `crypto`\n// object isn't exposed either. Rather than guess at sandbox internals\n// a third time, this uses only fundamental JavaScript with zero\n// external dependency - guaranteed available in any JS engine.\n// Adequate here specifically because this token is short-lived (10\n// minutes), single-use (checked against the database), and not the\n// only line of defense - it doesn't need to withstand sophisticated\n// cryptanalysis, just prevent casual CSRF/replay in its narrow window.\nfunction randomSegment() {\n  return Math.random().toString(36).slice(2) + Date.now().toString(36);\n}\nconst state = randomSegment() + '-' + randomSegment() + '-' + randomSegment();\n\nreturn [{ json: {\n  decision: 'VALID',\n  seller_id: body.seller_id,\n  state: state\n}}];"
      },
