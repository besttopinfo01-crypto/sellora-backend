        "jsCode": "const prev = $('Validate Input & Generate State').first().json;\n\n// version=beta is required while the app is still in Draft / not yet\n// publicly listed - remove this parameter once the app is actually\n// listed on the Selling Partner Appstore, or it will authorize the\n// wrong (draft) version.\nconst consentUrl = 'https://sellercentral.amazon.com/apps/authorize/consent'\n  + '?application_id=' + encodeURIComponent('amzn1.sp.solution.5e1b73ff-7d0c-4c99-a019-dccd1d314d85')\n  + '&state=' + encodeURIComponent(prev.state)\n  + '&version=beta';\n\nreturn [{ json: { redirect_url: consentUrl } }];"
