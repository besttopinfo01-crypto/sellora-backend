    {
      "parameters": {
        "jsCode": "const rawInput = $input.first().json;\nconst body = rawInput.body ? rawInput.body : rawInput;\n\nif (!body.request_id) {\n  return [{ json: { decision: 'REJECTED', reason: 'MISSING_REQUEST_ID', message: 'request_id is required.' } }];\n}\n\nif (!Array.isArray(body.confirmations) || body.confirmations.length !== 5) {\n  return [{ json: { decision: 'REJECTED', reason: 'INVALID_CONFIRMATIONS', message: 'confirmations must be an array of exactly 5 items - the same 5 shown on the Approval screen.' } }];\n}\n\n// Re-checked here, not just trusted from the disabled button on the\n// frontend - same belt-and-suspenders principle Approval's own submit\n// button already follows (see its own code comment), just enforced\n// server-side too, since a disabled button is a UI convenience, not a\n// security boundary.\nconst uncheckedIndices = body.confirmations\n  .map(function(c, i) { return { index: i, checked: !!(c && c.checked) }; })\n  .filter(function(c) { return !c.checked; })\n  .map(function(c) { return c.index; });\n\nif (uncheckedIndices.length > 0) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'CONFIRMATIONS_INCOMPLETE',\n    message: 'All 5 confirmations must be checked before an approval can be logged.',\n    unchecked_indices: uncheckedIndices\n  }}];\n}\n\nif (!body.json_payload || typeof body.json_payload !== 'object') {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MISSING_PAYLOAD',\n    message: 'json_payload is required - build it via wf24 (existing-parent) or wf27 (new-parent) before calling this.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'VALID',\n  request_id: body.request_id,\n  approved_by: body.approved_by || 'seller',\n  confirmations: body.confirmations,\n  parent_content: body.parent_content || null,\n  json_payload: body.json_payload\n}}];"
      },
