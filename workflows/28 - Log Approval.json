    {
      "parameters": {
        "jsCode": "const validated = $('Validate Input').first().json;\nconst fetched = $input.first().json;\nconst row = Array.isArray(fetched) ? fetched[0] : fetched;\n\nif (!row || !row.request_id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MERGE_REQUEST_NOT_FOUND',\n    request_id: validated.request_id,\n    message: 'No merge_requests row found for this request_id - approval cannot be logged against a request that was never created.'\n  }}];\n}\n\n// approval_logs already existed in this Supabase project - built during\n// the original rebuild plan, before any Gen-2 workflow ever wrote to it,\n// and before this screen's confirmations grew from 4 checks to 5. Its 4\n// named boolean columns predate that growth. Items 1 and 2 here are both\n// about review manipulation/consolidation specifically, so both map onto\n// the single confirm_no_review_manipulation column; the other three map\n// through 1:1. is_new_parent and the new-parent content aren't stored\n// separately - is_new_parent is one join away via request_id, and the\n// generated title/bullets/description are already inside json_payload's\n// own parent listing patches, so duplicating them here would just be\n// storing the same data twice.\nconst c = validated.confirmations;\nconst notes = c.map(function(item, i) { return '(' + (i + 1) + ') ' + item.text; }).join(' ');\n\nreturn [{ json: {\n  decision: 'FOUND',\n  request_id: row.request_id,\n  seller_id: row.seller_id,\n  approved_by: validated.approved_by,\n  confirm_same_product_family: !!(c[0] && c[0].checked),\n  confirm_no_review_manipulation: !!(c[1] && c[1].checked) && !!(c[2] && c[2].checked),\n  confirm_matrix_correct: !!(c[3] && c[3].checked),\n  confirm_understands_risk: !!(c[4] && c[4].checked),\n  notes: notes,\n  json_payload: validated.json_payload\n}}];"
      },
