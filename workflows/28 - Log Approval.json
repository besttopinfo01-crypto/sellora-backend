    {
      "parameters": {
        "jsCode": "const inserted = $input.first().json;\nconst row = Array.isArray(inserted) ? inserted[0] : inserted;\n\nif (!row || !row.id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'APPROVAL_LOG_INSERT_FAILED',\n    message: 'The approval_logs insert did not return a row.',\n    upstream_raw: inserted\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'APPROVED_AND_LOGGED',\n  request_id: row.request_id,\n  approval_log_id: row.id,\n  // Real column is created_at, not approved_at - this table predates\n  // this workflow. Read the real column, still expose it as approved_at\n  // here so the frontend's existing contract doesn't need to change too.\n  approved_at: row.created_at,\n  message: 'Approval logged and the final payload staged. Nothing was sent to Amazon - live submission is still on hold pending Amazon app review.'\n}}];"
