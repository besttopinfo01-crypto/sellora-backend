    {
      "parameters": {
        "jsCode": "const identity = $('Identity Gate').first().json;\nconst token = $input.first().json.access_token;\n\nconst included = 'summaries,attributes,issues';\nconst url = 'https://sellingpartnerapi-na.amazon.com/listings/2021-08-01/items/'\n  + encodeURIComponent(identity.selling_partner_id) + '/'\n  + encodeURIComponent(identity.sku)\n  + '?marketplaceIds=' + encodeURIComponent(identity.marketplace_id)\n  + '&includedData=' + encodeURIComponent(included);\n\nreturn [{ json: { url: url, access_token: token } }];"
      },
