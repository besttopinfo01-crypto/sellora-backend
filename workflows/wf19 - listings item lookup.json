      "parameters": {
        "jsCode": "const rawInput = $input.first().json;\nconst body = rawInput.body ? rawInput.body : rawInput;\n\nif (!body.seller_id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MISSING_SELLER_ID',\n    message: 'seller_id is required.'\n  }}];\n}\n\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(body.seller_id)) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'INVALID_SELLER_ID_FORMAT',\n    message: 'seller_id must be a valid UUID.'\n  }}];\n}\n\nif (!body.sku || !body.marketplace_id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MISSING_REQUIRED_FIELDS',\n    message: 'sku and marketplace_id are both required. Note: this endpoint is SKU-keyed (the seller\\'s own internal SKU), not ASIN-keyed - use wf17 for ASIN/Catalog lookups.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'VALID',\n  seller_id: body.seller_id,\n  sku: String(body.sku).trim(),\n  marketplace_id: body.marketplace_id,\n  asin_hint: body.asin || null\n}}];"
      },
