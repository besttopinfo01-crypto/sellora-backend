    {
      "parameters": {
        "jsCode": "const rows = $('Get Selling Partner ID').first().json;\nconst ctx = $('Validate Input').first().json;\nconst identityRow = Array.isArray(rows) ? rows[0] : rows;\n\nconst sellerRows = $input.first().json;\nconst sellerRow = Array.isArray(sellerRows) ? sellerRows[0] : sellerRows;\n\nif (!sellerRow) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'SELLER_NOT_FOUND',\n    seller_id: ctx.seller_id,\n    message: 'No seller record exists for this seller_id.'\n  }}];\n}\n\nif (sellerRow.status !== 'active') {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'SELLER_NOT_ACTIVE',\n    seller_id: ctx.seller_id,\n    seller_status: sellerRow.status,\n    message: 'This seller account is not active (status: ' + sellerRow.status + '). Access is not permitted.'\n  }}];\n}\n\nif (!identityRow || !identityRow.selling_partner_id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'SELLER_NOT_CONNECTED',\n    seller_id: ctx.seller_id,\n    message: 'No Amazon connection is stored for this seller_id. Either it does not exist, or has not completed self-authorization / Merchant Token setup yet.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'HAS_IDENTITY',\n  seller_id: ctx.seller_id,\n  selling_partner_id: identityRow.selling_partner_id,\n  sku: ctx.sku,\n  marketplace_id: ctx.marketplace_id,\n  asin_hint: ctx.asin_hint\n}}];"
