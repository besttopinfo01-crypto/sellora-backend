    {
      "parameters": {
        "jsCode": "const upstream = $input.first().json;\nconst identity = $('Identity Gate').first().json;\n\n// A genuine SP-API 404 for an unlisted SKU, or any other upstream error.\nif (!upstream || upstream.error || (!upstream.sku && !upstream.summaries)) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'LISTING_NOT_FOUND',\n    sku: identity.sku,\n    marketplace_id: identity.marketplace_id,\n    message: 'No listing was found for this SKU under this seller account in this marketplace. Check the SKU and marketplace_id.',\n    upstream_raw: upstream\n  }}];\n}\n\nfunction forMarketplace(list) {\n  if (!Array.isArray(list)) return {};\n  return list.find(function(e) { return e.marketplaceId === identity.marketplace_id; }) || list[0] || {};\n}\n\nconst summary = forMarketplace(upstream.summaries);\n\n// DEFENSIVE PARSE (Day 24, first-ever call to this endpoint in the rebuild):\n// written against the documented Listings Items attribute shape, same\n// pattern as wf17's first build - if real data comes back differently,\n// paste the raw response and the parse gets corrected against real shape,\n// same as every other endpoint in this project so far.\nconst rawAttributes = upstream.attributes || {};\nconst attributes = {};\nObject.keys(rawAttributes).forEach(function(attrName) {\n  const entries = rawAttributes[attrName];\n  if (!Array.isArray(entries) || entries.length === 0) {\n    attributes[attrName] = entries;\n    return;\n  }\n  const relevant = entries.filter(function(e) { return !e.marketplace_id || e.marketplace_id === identity.marketplace_id; });\n  const list = relevant.length > 0 ? relevant : entries;\n  const allHaveValue = list.every(function(e) { return e && e.value !== undefined; });\n\n  if (allHaveValue && list.length === 1) {\n    attributes[attrName] = list[0].value;                            // color, brand, list_price, ... (proven: \"Blue\")\n  } else if (allHaveValue) {\n    attributes[attrName] = list.map(function(e) { return e.value; }); // bullet_point -> all 5 values now, not just #1\n  } else {\n    attributes[attrName] = entries;                                   // shirt_size, neck, sleeve, images: compound, kept raw\n  }\n});\n\nconst issues = Array.isArray(upstream.issues) ? upstream.issues : [];\n\nreturn [{ json: {\n  decision: 'LISTING_FOUND',\n  sku: identity.sku,\n  asin_hint: identity.asin_hint,\n  marketplace_id: identity.marketplace_id,\n  product_type: summary.productType || null,\n  status: summary.status || null,\n  item_name: summary.itemName || null,\n  attributes: attributes,\n  attribute_names_set: Object.keys(attributes),\n  issues: issues,\n  has_issues: issues.length > 0,\n  raw_upstream: upstream\n}}];"
      },
