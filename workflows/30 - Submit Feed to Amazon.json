    {
      "parameters": {
        "jsCode": "const upstream = $input.first().json;\nconst feedId = upstream.feedId;\n\nif (!feedId) {\n  const isRateLimited = upstream && (upstream.statusCode === 429 ||\n    (Array.isArray(upstream.errors) && upstream.errors.some(function(e) { return e.code === 'QuotaExceeded' || e.code === 'Throttled'; })));\n  // Same distinction as Parse Feed Document, confirmed against the same\n  // Amazon documentation and real reports - a missing/insufficient\n  // SP-API role or region/marketplace mismatch, not a rate limit and not\n  // a data problem with the feed content itself.\n  const isPermissionDenied = upstream && (upstream.statusCode === 403 ||\n    (Array.isArray(upstream.errors) && upstream.errors.some(function(e) { return e.code === 'Unauthorized'; })));\n\n  let reason = 'FEED_SUBMIT_FAILED';\n  let message = 'createFeed did not return a feedId. The feed content was uploaded successfully but never actually submitted. See upstream_raw for the real error.';\n  if (isRateLimited) {\n    reason = 'AMAZON_RATE_LIMITED';\n    message = 'Amazon rejected the submission itself as rate-limited even though our own seller-level counter showed room - the feed content was uploaded but never actually submitted. Try again shortly.';\n  } else if (isPermissionDenied) {\n    reason = 'AMAZON_PERMISSION_DENIED';\n    message = 'Amazon rejected the submission because the app\\'s current authorization does not cover this action - most often a missing SP-API role for feed submission, or a region/marketplace mismatch. The feed content was uploaded but never actually submitted. This is not a problem with the listing data; it needs the account\\'s authorized roles checked (or the account reauthorized), not a data fix.';\n  }\n\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: reason,\n    message: message,\n    upstream_raw: upstream\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'FEED_SUBMITTED',\n  feed_id: feedId,\n  request_id: $('Confirm No Duplicate').first().jso