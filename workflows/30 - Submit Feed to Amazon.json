    {
      "parameters": {
        "jsCode": "const upstream = $input.first().json;\nconst feedDocumentId = upstream.feedDocumentId;\nconst uploadUrl = upstream.url;\n\nif (!feedDocumentId || !uploadUrl) {\n  // Our own rate-limit reservation just confirmed this seller was under\n  // 5 submissions in the last 5 minutes - but that only counts attempts\n  // made through Catalove. If this seller (or another tool on the same\n  // account) has used up their real Amazon-side quota some other way,\n  // Amazon can still return a genuine 429 here regardless of what our\n  // own counter says. Worth telling apart from an unrelated failure.\n  const isRateLimited = upstream && (upstream.statusCode === 429 ||\n    (Array.isArray(upstream.errors) && upstream.errors.some(function(e) { return e.code === 'QuotaExceeded' || e.code === 'Throttled'; })));\n  // Confirmed directly against Amazon's own SP-API authorization-errors\n  // documentation, and against multiple independent real reports of the\n  // exact response body (including issues filed directly against\n  // Amazon's own amzn/selling-partner-api-models and -docs GitHub repos):\n  // a missing/insufficient SP-API role, or a region/marketplace mismatch,\n  // comes back as HTTP 403 with errors[].code === \"Unauthorized\" - that's\n  // Amazon's own naming for this, not the more intuitive \"Forbidden\".\n  // Distinct from a rate limit, and distinct from a data problem -\n  // checking the app's authorized roles (or reauthorizing) is what\n  // actually fixes this, not touching the feed content.\n  const isPermissionDenied = upstream && (upstream.statusCode === 403 ||\n    (Array.isArray(upstream.errors) && upstream.errors.some(function(e) { return e.code === 'Unauthorized'; })));\n\n  let reason = 'FEED_DOCUMENT_CREATE_FAILED';\n  let message = 'createFeedDocument did not return a feedDocumentId and upload url. See upstream_raw for the real error.';\n  if (isRateLimited) {\n    reason = 'AMAZON_RATE_LIMITED';\n    message = 'Amazon rejected this as rate-limited even though our own seller-level counter showed room - likely another tool on this seller\\'s account also submitting feeds. Try again shortly.';\n  } else if (isPermissionDenied) {\n    reason = 'AMAZON_PERMISSION_DENIED';\n    message = 'Amazon rejected this because the app\\'s current authorization does not cover this action - most often a missing SP-API role for feed submission, or a region/marketplace mismatch. This is not a problem with the listing data; it needs the account\\'s authorized roles checked (or the account reauthorized), not a data fix.';\n  }\n\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: reason,\n    message: message,\n    upstream_raw: upstream\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'DOCUMENT_CREATED',\n  feed_document_id: feedDocumentId,\n  upload_url: uploadUrl\n}}];"
      },
