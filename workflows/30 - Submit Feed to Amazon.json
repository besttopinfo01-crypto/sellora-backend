        "jsCode": "const validated = $('Validate Input').first().json;\n\nconst approvalRaw = $('Fetch Approval Log').first().json;\nconst approvalRow = Array.isArray(approvalRaw) ? approvalRaw[0] : approvalRaw;\n\nconst mergeRaw = $('Fetch Merge Request').first().json;\nconst mergeRow = Array.isArray(mergeRaw) ? mergeRaw[0] : mergeRaw;\n\nif (!approvalRow || !approvalRow.id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'NOT_APPROVED',\n    request_id: validated.request_id,\n    message: 'No approval_logs row found for this request_id - Approval must be completed before this can run.'\n  }}];\n}\n\nif (approvalRow.approval_status !== 'approved') {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'APPROVAL_NOT_CONFIRMED',\n    request_id: validated.request_id,\n    message: 'The most recent approval_logs row has approval_status=' + approvalRow.approval_status + ', not approved.'\n  }}];\n}\n\nif (!approvalRow.staged_payload_json) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'NO_STAGED_PAYLOAD',\n    request_id: validated.request_id,\n    message: 'The approval_logs row exists but has no staged_payload_json - nothing to submit.'\n  }}];\n}\n\nif (!mergeRow || !mergeRow.marketplace_id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MERGE_REQUEST_NOT_FOUND',\n    request_id: validated.request_id,\n    message: 'No merge_requests row found (or it is missing marketplace_id) for this request_id.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'READY',\n  request_id: validated.request_id,\n  seller_id: approvalRow.seller_id,\n  marketplace_id: mergeRow.marketplace_id,\n  staged_payload_json: approvalRow.staged_payload_json\n}}];"
