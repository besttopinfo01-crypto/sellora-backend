    {
      "parameters": {
        "jsCode": "const upstream = $input.first().json;\nconst req = $('Validate Input').first().json;\n\n// A real Catalog Items response always carries the asin back.\nif (!upstream || upstream.error || !upstream.asin) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'PARENT_NOT_FOUND',\n    parent_asin: req.parent_asin,\n    marketplace_id: req.marketplace_id,\n    message: 'Amazon Catalog Items API did not return this ASIN for this marketplace. Check the ASIN, the marketplace_id, and that the stored refresh token is still valid.',\n    upstream_raw: upstream\n  }}];\n}\n\nfunction forMarketplace(list) {\n  if (!Array.isArray(list)) return {};\n  return list.find(function(e) { return e.marketplaceId === req.marketplace_id; }) || list[0] || {};\n}\n\nconst summary = forMarketplace(upstream.summaries);\nconst ptEntry = forMarketplace(upstream.productTypes);\nconst relEntry = forMarketplace(upstream.relationships);\n\nconst groups = Array.isArray(relEntry.relationships) ? relEntry.relationships : [];\nconst variationGroup = groups.find(function(g) { return g.type === 'VARIATION'; }) || null;\n\nconst childAsins = (variationGroup && Array.isArray(variationGroup.childAsins)) ? variationGroup.childAsins : [];\nconst parentAsins = (variationGroup && Array.isArray(variationGroup.parentAsins)) ? variationGroup.parentAsins : [];\nconst variationTheme = (variationGroup && variationGroup.variationTheme) ? variationGroup.variationTheme : null;\n\nconst baseInfo = {\n  brand: summary.brand || null,\n  item_name: summary.itemName || null,\n  product_type: ptEntry.productType || null,\n  category: (summary.browseClassification && summary.browseClassification.displayName) || null\n};\n\n// Case 1: this ASIN has children -> it IS a variation parent.\nif (childAsins.length > 0) {\n  return [{ json: {\n    decision: 'PARENT_CONFIRMED',\n    parent_asin: req.parent_asin,\n    marketplace_id: req.marketplace_id,\n    parent_preview: Object.assign({}, baseInfo, {\n      variation_theme: variationTheme ? (variationTheme.theme || null) : null,\n      theme_attributes: variationTheme ? (variationTheme.attributes || []) : [],\n      child_count: childAsins.length,\n      child_asins: childAsins\n    }),\n    raw_variation_group: variationGroup\n  }}];\n}\n\n// Case 2: this ASIN itself belongs to a parent -> it is a CHILD, not a parent.\nif (parentAsins.length > 0) {\n  return [{ json: {\n    decision: 'NOT_A_PARENT',\n    reason: 'ASIN_IS_A_CHILD',\n    parent_asin: req.parent_asin,\n    marketplace_id: req.marketplace_id,\n    is_child_of: parentAsins,\n    message: 'This ASIN is itself a child in an existing variation family. Enter its parent ASIN instead.',\n    item_info: baseInfo,\n    raw_variation_group: variationGroup\n  }}];\n}\n\n// Case 3: no VARIATION relationship at all -> standalone listing.\nreturn [{ json: {\n  decision: 'NOT_A_PARENT',\n  reason: 'NO_VARIATION_FAMILY',\n  parent_asin: req.parent_asin,\n  marketplace_id: req.marketplace_id,\n  message: 'This ASIN exists but has no variation relationships in the catalog - it is a standalone listing, not a parent.',\n  item_info: baseInfo\n}}];"
      },
