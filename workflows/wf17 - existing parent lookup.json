      "parameters": {
        "jsCode": "const rawInput = $input.first().json;\nconst body = rawInput.body ? rawInput.body : rawInput;\n\nif (!body.seller_id) {\n  return [{ json: { decision: 'REJECTED', reason: 'MISSING_SELLER_ID', message: 'seller_id is required.' } }];\n}\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(body.seller_id)) {\n  return [{ json: { decision: 'REJECTED', reason: 'INVALID_SELLER_ID_FORMAT', message: 'seller_id must be a valid UUID.' } }];\n}\n\nif (!body.parent_asin || !body.marketplace_id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MISSING_REQUIRED_FIELDS',\n    message: 'parent_asin and marketplace_id are both required.'\n  }}];\n}\n\nconst asin = String(body.parent_asin).trim().toUpperCase();\n\nif (!/^[A-Z0-9]{10}$/.test(asin)) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'INVALID_ASIN_FORMAT',\n    message: 'parent_asin must be a 10-character alphanumeric Amazon ASIN (e.g. B0CVFVHY93).',\n    parent_asin: body.parent_asin\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'VALID',\n  seller_id: body.seller_id,\n  parent_asin: asin,\n  marketplace_id: body.marketplace_id\n}}];"
      },
