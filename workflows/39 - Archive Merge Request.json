      "parameters": {
        "jsCode": "const fetched = $input.first().json;\nconst row = Array.isArray(fetched) ? fetched[0] : fetched;\nconst ctx = $('Validate Input').first().json;\n\nif (!row || !row.request_id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MERGE_REQUEST_NOT_FOUND',\n    request_id: ctx.request_id,\n    message: 'No merge_requests row found for this request_id.'\n  }}];\n}\n\nif (ctx.action === 'archive' && row.archived_at) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'ALREADY_ARCHIVED',\n    request_id: row.request_id,\n    message: 'This request is already archived.'\n  }}];\n}\n\nif (ctx.action === 'unarchive' && !row.archived_at) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'NOT_ARCHIVED',\n    request_id: row.request_id,\n    message: 'This request is not currently archived - there is nothing to restore.'\n  }}];\n}\n\n// The actual value to PATCH is computed here, as a real JS value (a real\n// ISO string, or a real null), not as text - so the PATCH node downstream\n// can use the same proven whole-body JSON.stringify($json) pattern from\n// wf23, rather than trying to splice a conditional expression into the\n// middle of hand-written JSON text (the exact fragile pattern that broke\n// workflow 39's own now-42nd sibling earlier today).\nreturn [{ json: {\n  decision: 'FOUND',\n  request_id: row.request_id,\n  action: ctx.action,\n  archived_at: ctx.action === 'archive' ? new Date().toISOString() : null\n}}];"
