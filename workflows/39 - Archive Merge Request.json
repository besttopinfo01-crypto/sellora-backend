      "parameters": {
        "jsCode": "const rawInput = $input.first().json;\nconst body = rawInput.body ? rawInput.body : rawInput;\n\nif (!body.request_id) {\n  return [{ json: { decision: 'REJECTED', reason: 'MISSING_REQUEST_ID', message: 'request_id is required.' } }];\n}\n\n// Defaults to 'archive' when omitted, for backward compatibility with the\n// original archive-only caller - but an explicitly-provided, unrecognized\n// action is rejected outright rather than silently coerced, so a typo\n// doesn't quietly do the wrong thing to a real record.\nconst action = body.action === undefined ? 'archive' : body.action;\nif (action !== 'archive' && action !== 'unarchive') {\n  return [{ json: { decision: 'REJECTED', reason: 'INVALID_ACTION', message: 'action must be \"archive\" or \"unarchive\" if provided.' } }];\n}\n\nreturn [{ json: { decision: 'VALID', request_id: body.request_id, action: action } }];"
