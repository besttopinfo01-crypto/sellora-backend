    {
      "parameters": {
        "jsCode": "// Repackages what Validate State confirmed into the flat shape the\n// token-exchange chain below reads from. Named/dated from when the\n// exchange itself was still a next-session stub; it's since been wired\n// in directly below (spapi_oauth_code expires in 5 minutes, so it fires\n// immediately - nothing here queues or delays that).\nconst validated = $('Validate State').first().json;\nreturn [{ json: {\n  seller_id: validated.seller_id,\n  selling_partner_id: validated.selling_partner_id,\n  spapi_oauth_code: validated.spapi_oauth_code,\n  ready_for_token_exchange: true\n}}];"
