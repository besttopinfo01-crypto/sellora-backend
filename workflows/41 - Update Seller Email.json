    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body ? raw.body : raw;\n\nconst sellerId = (body.seller_id || '').trim();\nconst email = (body.contact_email || '').trim();\nconst EMAIL_REGEX = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst UUID_REGEX = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\n// This workflow used to create brand-new accounts from just an email\n// (the original self-signup flow). It's since been repurposed: new\n// accounts are now created by wf10 at the moment Amazon connects, so\n// this workflow's only job now is attaching a real email to an\n// *already-existing* seller_id - hence validating both, not email alone.\nif (!UUID_REGEX.test(sellerId)) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'INVALID_SELLER_ID',\n    message: 'Could not identify your account. Please try signing in again.'\n  }}];\n}\nif (!email || !EMAIL_REGEX.test(email)) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'INVALID_EMAIL',\n    message: 'Please enter a valid email address.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'VALID',\n  seller_id: sellerId,\n  contact_email: email\n}}];"
      },
