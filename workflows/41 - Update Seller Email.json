    {
      "parameters": {
        "jsCode": "const ctx = $('Validate Input').first().json;\nconst res = $input.first().json;\n\n// Same shape-based success/failure detection as the original signup\n// flow: a successful update comes back with the user's own id.\nconst updatedId = (res && res.id) ? res.id : ((res && res.user && res.user.id) ? res.user.id : null);\n\nif (!updatedId) {\n  // Reuses the exact digDeep unwrapping the original signup flow\n  // needed - n8n wraps a failed HTTP call's real body the same way\n  // regardless of which admin endpoint produced it. Most likely\n  // failure here specifically: the email is already in use on a\n  // different account.\nfunction tryParseAt(str, startIdx) {\n  for (let end = str.length; end > startIdx; end--) {\n    try {\n      return JSON.parse(str.slice(startIdx, end));\n    } catch (e) {\n      // keep shrinking\n    }\n  }\n  return undefined;\n}\nfunction digDeep(str) {\n  if (typeof str !== 'string') return null;\n  let current = str;\n  for (let depth = 0; depth < 4; depth++) {\n    let bestStart = -1;\n    for (let i = 0; i < current.length; i++) {\n      if (current[i] === '{' || current[i] === '\"') { bestStart = i; break; }\n    }\n    if (bestStart === -1) return null;\n    const parsed = tryParseAt(current, bestStart);\n    if (parsed === undefined) return null;\n    if (parsed && typeof parsed === 'object') {\n      if (typeof parsed.msg === 'string') return parsed.msg;\n      if (typeof parsed.message === 'string') return parsed.message;\n      return null;\n    }\n    if (typeof parsed === 'string') {\n      current = parsed;\n      continue;\n    }\n    return null;\n  }\n  return null;\n}\nfunction extractMessage(r) {\n  if (!r) return null;\n  const flat = [r.msg, r.message, r.error_description, (typeof r.error === 'string' ? r.error : null)];\n  for (const c of flat) {\n    if (typeof c === 'string' && c) return digDeep(c) || c;\n  }\n  if (r.error && typeof r.error === 'object' && typeof r.error.message === 'string') {\n    return digDeep(r.error.message) || r.error.message;\n  }\n  return null;\n}\n  const message = extractMessage(res)\n    || 'Could not update your email - it may already be in use on another account.';\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'AUTH_UPDATE_FAILED',\n    message: message\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'UPDATED',\n  seller_id: ctx.seller_id,\n  contact_email: ctx.contact_email\n}}];"
      },
