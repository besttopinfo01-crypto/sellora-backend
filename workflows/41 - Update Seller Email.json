    {
      "parameters": {
        "jsCode": "const created = $('Check Auth Result').first().json;\nconst updateResult = $input.first().json;\nconst updatedRow = Array.isArray(updateResult) ? updateResult[0] : updateResult;\n\n// Prefer: return=representation, same reasoning as the original\n// signup flow: success and failure arrive as genuinely different\n// shapes instead of an ambiguous empty body.\nif (!updatedRow || updatedRow.contact_email !== created.contact_email) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'SELLER_ROW_UPDATE_FAILED',\n    message: 'Your sign-in was updated but something went wrong saving your email. Please try again.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'EMAIL_SAVED',\n  seller_id: created.seller_id\n}}];"
