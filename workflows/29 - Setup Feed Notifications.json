    {
      "parameters": {
        "jsCode": "const rawInput = $input.first().json;\nconst body = rawInput.body ? rawInput.body : rawInput;\n\n// Run this once, manually, not from the app - it registers one\n// application-wide destination/subscription, not something tied to a\n// single seller_id. FEED_PROCESSING_FINISHED notifications carry their\n// own sellerId in the payload, which is how the consuming side (wf07)\n// will know which seller's submission_logs row to update.\nif (!body.sqs_queue_arn) {\n  return [{ json: { decision: 'REJECTED', reason: 'MISSING_QUEUE_ARN', message: 'sqs_queue_arn is required - create the SQS queue in AWS first, grant SP-API (AWS account 437568002678) sqs:SendMessage and sqs:GetQueueAttributes on it, then pass its ARN here.' } }];\n}\nif (!/^arn:aws:sqs:[a-z0-9-]+:\\d{12}:\\S+$/.test(body.sqs_queue_arn)) {\n  return [{ json: { decision: 'REJECTED', reason: 'INVALID_QUEUE_ARN', message: 'sqs_queue_arn does not look like a real SQS ARN (expected arn:aws:sqs:{region}:{account-id}:{queue-name}).' } }];\n}\n\nreturn [{ json: {\n  decision: 'VALID',\n  sqs_queue_arn: body.sqs_queue_arn,\n  destination_name: body.destination_name || 'catalove-feed-notifications'\n}}];"
      },
