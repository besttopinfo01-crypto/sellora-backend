    {
      "parameters": {
        "jsCode": "const upstream = $input.first().json;\n\n// createDestination fails with a real error if a destination pointing\n// at this same SQS ARN already exists - surfaced directly rather than\n// guessed at, since the exact shape of that specific error hasn't been\n// confirmed against a real call yet. If this happens and it really is\n// a duplicate, use GET /notifications/v1/destinations to find the\n// existing destinationId instead of creating a new one.\nconst destinationId = upstream.payload && upstream.payload.destinationId;\n\nif (!destinationId) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'DESTINATION_CREATE_FAILED',\n    message: 'createDestination did not return a destinationId. See upstream_raw for the real error.',\n    upstream_raw: upstream\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'DESTINATION_READY',\n  destination_id: destinationId\n}}];"
      },
