      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const destination = $('Parse Destination').first().json;\nconst upstream = $input.first().json;\nconst subscriptionId = upstream.payload && upstream.payload.subscriptionId;\n\nif (!subscriptionId) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'SUBSCRIPTION_CREATE_FAILED',\n    destination_id: destination.destination_id,\n    message: 'createSubscription did not return a subscriptionId - the destination was created successfully, but the subscription was not. See upstream_raw for the real error.',\n    upstream_raw: upstream\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'SUBSCRIBED',\n  destination_id: destination.destination_id,\n  subscription_id: subscriptionId,\n  notification_type: 'FEED_PROCESSING_FINISHED',\n  message: 'Destination and subscription created. Feed-processing notifications will now be pushed to the SQS queue instead of requiring wf07 to poll Amazon for each pending feed.'\n}}];"
      },
