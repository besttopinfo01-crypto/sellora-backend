    {
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\n// direct_submission_report must stay a bare array here, not wrapped in an\n// object - confirmed directly against wf38's own real Resolve Results\n// node, which does Array.isArray(mergeRequestRow.direct_submission_report)\n// and treats anything else as \"no report at all.\" wf32/wf34 both already\n// write this column as a bare array; wrapping it here (as an earlier,\n// unverified version of this file did) silently broke wf38's own \"See\n// why\" explanation for any request that had ever been through a recheck -\n// found from a real, live symptom, not caught by any test written before\n// this. final_status doesn't need to live inside this column at all - it\n// is already set as its own top-level status field on this same PATCH.\nreturn [{ json: {\n  status: ctx.final_status,\n  direct_submission_report: ctx.results\n}}];"
