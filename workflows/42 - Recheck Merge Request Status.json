      "parameters": {
        "jsCode": "const rows = $('Get Selling Partner ID').first().json;\nconst ctx = $('Check Has Report').first().json;\nconst identityRow = Array.isArray(rows) ? rows[0] : rows;\n\nconst sellerRows = $input.first().json;\nconst sellerRow = Array.isArray(sellerRows) ? sellerRows[0] : sellerRows;\n\nif (!sellerRow) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'SELLER_NOT_FOUND', seller_id: ctx.seller_id,\n    message: 'No seller record exists for this seller_id.'\n  }}];\n}\n\nif (sellerRow.status !== 'active') {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'SELLER_NOT_ACTIVE', seller_id: ctx.seller_id, seller_status: sellerRow.status,\n    message: 'This seller account is not active (status: ' + sellerRow.status + '). Access is not permitted.'\n  }}];\n}\n\nif (!identityRow || !identityRow.selling_partner_id) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'SELLER_NOT_CONNECTED', seller_id: ctx.seller_id,\n    message: 'No Amazon connection is stored for this seller_id.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'HAS_IDENTITY',\n  request_id: ctx.request_id,\n  seller_id: ctx.seller_id,\n  selling_partner_id: identityRow.selling_partner_id,\n  marketplace_id: ctx.marketplace_id,\n  results: ctx.results\n}}];"
