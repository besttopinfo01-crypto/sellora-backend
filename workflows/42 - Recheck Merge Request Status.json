      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst ctx = $('Validate Input').first().json;\nconst found = Array.isArray(row) ? row[0] : row;\n\nif (!found || !found.request_id) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'MERGE_REQUEST_NOT_FOUND', request_id: ctx.request_id,\n    message: 'No merge_requests row found for this request_id.'\n  }}];\n}\n\nconst report = found.direct_submission_report;\n// Two real shapes have to be handled here, not just one guessed from\n// memory: wf32/wf34's own original writes store this as a bare array\n// directly, while a request that has already been through this same\n// recheck workflow once before will have it wrapped as {results: [...]}\n// from Build Patch Body's own output. Confirmed directly against a real\n// stored row rather than assumed from what this workflow itself writes.\nlet results = null;\nif (Array.isArray(report)) {\n  results = report;\n} else if (report && Array.isArray(report.results)) {\n  results = report.results;\n}\n\nif (!results || results.length === 0) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'NOTHING_TO_RECHECK', request_id: found.request_id,\n    message: 'This request has no direct submission results yet - there is nothing real to recheck until it has actually been submitted at least once.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'HAS_REPORT',\n  request_id: found.request_id,\n  seller_id: found.seller_id,\n  marketplace_id: found.marketplace_id,\n  results: results\n}}];"
