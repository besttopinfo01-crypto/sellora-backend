    {
      "parameters": {
        "jsCode": "const ctx = $('Check Has Report').first().json;\nconst identity = $('Identity Gate').first().json;\nconst token = $('Exchange for Access Token').first().json.access_token;\n\nreturn ctx.results.map(function(r) {\n  return { json: {\n    sku: r.sku,\n    // A parent row (from wf32/34's own Summarize Results) carries\n    // verified_parent; every child row carries verified_child instead -\n    // same distinguishing field already used throughout this project's\n    // own direct_submission_report shape.\n    is_parent: r.verified_parent !== undefined,\n    original_patch_status: r.patch_status !== undefined ? r.patch_status : null,\n    original_patch_issues: r.patch_issues || [],\n    original_error: r.error || null,\n    selling_partner_id: identity.selling_partner_id,\n    marketplace_id: identity.marketplace_id,\n    access_token: token\n  }};\n});"
      },
