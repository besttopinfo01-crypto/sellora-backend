    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst included = 'summaries,attributes,issues';\nconst url = 'https://sellingpartnerapi-na.amazon.com/listings/2021-08-01/items/'\n  + encodeURIComponent(item.selling_partner_id) + '/'\n  + encodeURIComponent(item.sku)\n  + '?marketplaceIds=' + encodeURIComponent(item.marketplace_id)\n  + '&includedData=' + encodeURIComponent(included);\n\nreturn [{ json: {\n  url: url,\n  access_token: item.access_token,\n  sku: item.sku,\n  is_parent: item.is_parent,\n  original_patch_status: item.original_patch_status,\n  original_patch_issues: item.original_patch_issues,\n  original_error: item.original_error\n}}];"
