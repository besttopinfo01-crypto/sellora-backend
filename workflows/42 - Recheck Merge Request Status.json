    },
    {
      "parameters": {
        "jsCode": "const upstream = $input.first().json;\nconst ctx = $('Build Listings URL').first().json;\n\nif (!upstream || upstream.error || (!upstream.sku && !upstream.summaries)) {\n  const result = {\n    sku: ctx.sku,\n    patch_status: ctx.original_patch_status,\n    patch_issues: ctx.original_patch_issues,\n    verify_issues: [{\n      code: 'RECHECK_LOOKUP_FAILED',\n      message: 'Could not fetch this listing\\'s current state from Amazon to recheck it.',\n      severity: 'ERROR',\n      categories: []\n    }],\n    error: ctx.original_error\n  };\n  if (ctx.is_parent) { result.verified_parent = false; } else { result.verified_child = false; }\n  return [{ json: result }];\n}\n\nconst issues = Array.isArray(upstream.issues) ? upstream.issues : [];\n// Same ERROR-vs-everything-else distinction already established and\n// tested throughout this project (e.g. the FBA-conversion WARNING that\n// never blocks anything) - only a real ERROR-severity issue means this\n// listing is still genuinely not clean, not the mere presence of any\n// issue at all.\nconst errorIssues = issues.filter(function(i) { return i.severity === 'ERROR'; });\nconst isCleanNow = errorIssues.length === 0;\n\nconst result = {\n  sku: ctx.sku,\n  patch_status: ctx.original_patch_status,\n  patch_issues: ctx.original_patch_issues,\n  verify_issues: issues,\n  error: ctx.original_error\n};\nif (ctx.is_parent) { result.verified_parent = isCleanNow; } else { result.verified_child = isCleanNow; }\nreturn [{ json: result }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        1744
      ],
      "id": "552fc07d-1b7a-4a00-983e-7358f92076a5",
