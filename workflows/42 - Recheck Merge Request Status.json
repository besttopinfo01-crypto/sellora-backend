        "jsCode": "const upstream = $input.first().json;\nconst row = Array.isArray(upstream) ? upstream[0] : upstream;\n\nif (row && row.allowed === false) {\n  return [{ json: { decision: 'RATE_LIMITED', message: 'Too many rechecks for this seller in a short window. Try again shortly.' } }];\n}\nreturn [{ json: { decision: 'OK' } }];"
