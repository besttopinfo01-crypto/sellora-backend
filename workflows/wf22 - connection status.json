        "jsCode": "const sellerRows = $input.first().json;\nconst sellerRow = Array.isArray(sellerRows) ? sellerRows[0] : sellerRows;\nconst ctx = $('Validate Input').first().json;\n\nif (!sellerRow) {\n  return [{ json: { decision: 'SELLER_NOT_FOUND', seller_id: ctx.seller_id, connected: false } }];\n}\nif (sellerRow.status !== 'active') {\n  return [{ json: { decision: 'SELLER_NOT_ACTIVE', seller_id: ctx.seller_id, seller_status: sellerRow.status, connected: false } }];\n}\n\nreturn [{ json: {\n  decision: 'STATUS_READY',\n  seller_id: ctx.seller_id,\n  connected: !!sellerRow.amazon_connected_at,\n  connected_at: sellerRow.amazon_connected_at || null,\n  marketplace_id: sellerRow.marketplace_id || null\n}}];"
