      "parameters": {
        "jsCode": "const sellerRows = $input.first().json;\nconst sellerRow = Array.isArray(sellerRows) ? sellerRows[0] : sellerRows;\nconst ctx = $('Validate Input').first().json;\n\nif (!sellerRow) {\n  return [{ json: { decision: 'SELLER_NOT_FOUND', seller_id: ctx.seller_id, connected: false } }];\n}\nif (sellerRow.status !== 'active') {\n  return [{ json: { decision: 'SELLER_NOT_ACTIVE', seller_id: ctx.seller_id, seller_status: sellerRow.status, connected: false } }];\n}\n\n// A seller created straight from the \"Connect Your Amazon Seller\n// Account\" landing button (wf10) starts with a system-generated\n// placeholder at this exact domain, not a real inbox - see wf10's\n// \"Build Placeholder Signup\" node. Anyone who signed up the older\n// way, or who has since added a real one via the dashboard's \"add\n// your email\" prompt, has a genuine address here instead.\nconst email = sellerRow.contact_email || '';\nconst needsEmail = email.endsWith('@connect.catalove.internal');\n\nreturn [{ json: {\n  decision: 'STATUS_READY',\n  seller_id: ctx.seller_id,\n  connected: !!sellerRow.amazon_connected_at,\n  connected_at: sellerRow.amazon_connected_at || null,\n  marketplace_id: sellerRow.marketplace_id || null,\n  needs_email: needsEmail\n}}];"
