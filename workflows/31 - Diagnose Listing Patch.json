        "jsCode": "const rawInput = $input.first().json;\nconst body = rawInput.body ? rawInput.body : rawInput;\n\nif (!body.request_id) {\n  return [{ json: { decision: 'REJECTED', reason: 'MISSING_REQUEST_ID', message: 'request_id is required.' } }];\n}\nif (!body.sku) {\n  return [{ json: { decision: 'REJECTED', reason: 'MISSING_SKU', message: 'sku is required - which message from the staged payload to test directly.' } }];\n}\n\nreturn [{ json: { decision: 'VALID', request_id: body.request_id, sku: body.sku } }];"
