    {
      "parameters": {
        "jsCode": "const patchUpstream = $('Patch Listing Item Directly').first().json;\nconst realState = $input.first().json;\nconst context = $('Extract Message For SKU').first().json;\n\n// ACCEPTED from the patch call only means synchronous validation passed\n// - Amazon's own FAQ is explicit that the actual catalog update happens\n// downstream and can generate its own separate, asynchronous issues\n// never visible in that first response. This re-fetches the listing's\n// real current state right after, including any issues that only show\n// up post-processing - the actual answer, not just what submission said.\nconst realAttributes = realState.attributes || {};\nconst isChildNow = !!(realAttributes.parentage_level &&\n  realAttributes.parentage_level.some(function(e) { return e.value === 'child'; }));\n\nreturn [{ json: {\n  decision: 'CHECKED',\n  request_id: context.request_id,\n  sku: context.sku,\n  patches_sent: context.patches,\n  submission_response: patchUpstream,\n  real_current_state: {\n    is_child_now: isChildNow,\n    parentage_level: realAttributes.parentage_level || null,\n    child_parent_sku_relationship: realAttributes.child_parent_sku_relationship || null,\n    // Added after this specific gap was found live: this node used to\n    // surface only two named attributes, which couldn't answer whether\n    // an unrelated attribute (like color vs color_name) was actually\n    // set. All_attribute_keys shows what genuinely exists right now,\n    // without needing to guess the right key name in advance.\n    all_attribute_keys: Object.keys(realAttributes),\n    full_attributes: realAttributes,\n    issues: realState.issues || []\n  }\n}}];"
      },
