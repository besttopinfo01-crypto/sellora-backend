      "parameters": {
        "jsCode": "const validated = $('Validate Input').first().json;\n\nconst approvalRaw = $('Fetch Approval Log').first().json;\nconst approvalRow = Array.isArray(approvalRaw) ? approvalRaw[0] : approvalRaw;\n\nconst mergeRaw = $('Fetch Merge Request').first().json;\nconst mergeRow = Array.isArray(mergeRaw) ? mergeRaw[0] : mergeRaw;\n\nif (!approvalRow || !approvalRow.staged_payload_json) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'NO_STAGED_PAYLOAD', request_id: validated.request_id,\n    message: 'No approval_logs row with a staged payload found for this request_id.'\n  }}];\n}\nif (!mergeRow || !mergeRow.seller_id || !mergeRow.marketplace_id) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'MERGE_REQUEST_NOT_FOUND', request_id: validated.request_id,\n    message: 'No merge_requests row found (or missing seller_id/marketplace_id) for this request_id.'\n  }}];\n}\n\nconst messages = (approvalRow.staged_payload_json.messages) || [];\nconst match = messages.find(function(m) { return m.sku === validated.sku; });\n\nif (!match) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'SKU_NOT_IN_PAYLOAD', request_id: validated.request_id,\n    message: 'No message for sku \"' + validated.sku + '\" found in this request\\'s staged payload.',\n    available_skus: messages.map(function(m) { return m.sku; })\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'MESSAGE_FOUND',\n  request_id: validated.request_id,\n  seller_id: mergeRow.seller_id,\n  marketplace_id: mergeRow.marketplace_id,\n  sku: match.sku,\n  product_type: match.productType,\n  patches: match.patches\n}}];"
