    {
      "parameters": {
        "jsCode": "const upstream = $input.first().json;\nconst ready = $('Check Ready').first().json;\n\nconst summaries = upstream.summaries || [];\nconst attrs = upstream.attributes || {};\nconst hasAsin = summaries.length > 0 && !!summaries[0].asin;\nconst parentageValue = attrs.parentage_level && attrs.parentage_level[0] && attrs.parentage_level[0].value;\n\nreturn [{ json: {\n  decision: 'CHECKED',\n  mode: 'verify',\n  request_id: ready.request_id,\n  parent_sku: ready.parent_sku,\n  really_exists: hasAsin,\n  asin: hasAsin ? summaries[0].asin : null,\n  parentage_level_value: parentageValue || null,\n  genuinely_a_parent: parentageValue === 'parent',\n  issues: upstream.issues || [],\n  raw_response: upstream\n}}];"
