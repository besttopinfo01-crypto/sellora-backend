    {
      "parameters": {
        "jsCode": "const validated = $('Validate Input').first().json;\n\nconst approvalRaw = $('Fetch Approval Log').first().json;\nconst approvalRow = Array.isArray(approvalRaw) ? approvalRaw[0] : approvalRaw;\n\nconst mergeRaw = $('Fetch Merge Request').first().json;\nconst mergeRow = Array.isArray(mergeRaw) ? mergeRaw[0] : mergeRaw;\n\nif (!approvalRow || approvalRow.approval_status !== 'approved' || !approvalRow.staged_payload_json) {\n  return [{ json: { decision: 'REJECTED', reason: 'NOT_APPROVED', request_id: validated.request_id,\n    message: 'No approved, staged payload found for this request_id.' } }];\n}\nif (!mergeRow || !mergeRow.is_new_parent || !mergeRow.new_parent_sku) {\n  return [{ json: { decision: 'REJECTED', reason: 'WRONG_MODE', request_id: validated.request_id,\n    message: 'This request is not a new-parent merge (or has no new_parent_sku) - this diagnostic only applies to that mode.' } }];\n}\n\nconst parentMessage = (approvalRow.staged_payload_json.messages || []).find(function(m) { return m.sku === mergeRow.new_parent_sku; });\nif (!parentMessage) {\n  return [{ json: { decision: 'REJECTED', reason: 'PARENT_MESSAGE_NOT_FOUND', request_id: validated.request_id,\n    message: 'No message for the parent sku \"' + mergeRow.new_parent_sku + '\" found in the staged payload.' } }];\n}\n\nreturn [{ json: {\n  decision: 'READY',\n  request_id: validated.request_id,\n  action: validated.action,\n  seller_id: mergeRow.seller_id,\n  marketplace_id: mergeRow.marketplace_id,\n  parent_sku: mergeRow.new_parent_sku,\n  product_type: parentMessage.productType,\n  patches: parentMessage.patches\n}}];"
