        "jsCode": "const rawInput = $input.first().json;\nconst body = rawInput.body ? rawInput.body : rawInput;\n\nif (!body.request_id) {\n  return [{ json: { decision: 'REJECTED', reason: 'MISSING_REQUEST_ID', message: 'request_id is required.' } }];\n}\nif (body.action !== 'create' && body.action !== 'verify') {\n  return [{ json: { decision: 'REJECTED', reason: 'INVALID_ACTION', message: 'action must be \"create\" or \"verify\".' } }];\n}\n\nreturn [{ json: { decision: 'VALID', request_id: body.request_id, action: body.action } }];"
