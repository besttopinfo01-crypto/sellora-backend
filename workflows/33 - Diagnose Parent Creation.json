    {
      "parameters": {
        "jsCode": "// putListingsItem needs a flat attributes object, not the patches\n// array patchListingsItem uses - same attribute values either way,\n// different envelope. Converting rather than building fresh, so this\n// is exactly the content already staged and reviewed, not a\n// reconstruction that could drift from it.\nconst ready = $('Check Ready').first().json;\nconst attributes = {};\n\nfor (const patch of ready.patches) {\n  const attrName = patch.path.replace('/attributes/', '');\n  attributes[attrName] = patch.value;\n}\n\nreturn [{ json: {\n  request_id: ready.request_id,\n  seller_id: ready.seller_id,\n  marketplace_id: ready.marketplace_id,\n  parent_sku: ready.parent_sku,\n  product_type: ready.product_type,\n  attributes: attributes\n}}];"
