    {
      "parameters": {
        "jsCode": "const subInput = $('Fetch Submission Log').first().json;\nconst subRow = Array.isArray(subInput) ? subInput[0] : subInput;\n\nif (!subRow) {\n  return [{ json: {\n    decision: 'NOT_SUBMITTED',\n    request_id: $('Validate Input').first().json.request_id,\n    message: 'No submission found for this request yet.'\n  }}];\n}\n\nconst verInput = $('Fetch Verification').all();\nlet verRows;\nif (verInput.length === 1 && Array.isArray(verInput[0].json)) {\n  verRows = verInput[0].json;\n} else {\n  verRows = verInput.map(function(i) { return i.json; });\n}\nconst verRow = (verRows && verRows.length > 0) ? verRows[0] : null;\n\n// Maps the real values wf07/wf08 actually write into the GUI spec's\n// timeline stages. DONE alone is deliberately never a final state - the\n// spec is explicit that processing-done isn't shown as success until\n// verification actually confirms the relationship in the real catalog.\nlet stage = 'submitted';\nif (subRow.submission_status === 'FATAL') {\n  stage = 'failed';\n} else if (subRow.submission_status === 'DONE') {\n  if (!verRow) stage = 'verifying';\n  else stage = verRow.verification_status === 'verified_success' ? 'verified' : 'needs_review';\n} else if (subRow.submission_status && subRow.submission_status !== 'submitted') {\n  stage = 'processing';\n}\n\nreturn [{ json: {\n  decision: 'STATUS_READY',\n  request_id: subRow.request_id,\n  feed_id: subRow.feed_id,\n  stage: stage,\n  submission_status: subRow.submission_status,\n  processing_report: subRow.processing_report_json || null,\n  verification_status: verRow ? verRow.verification_status : null,\n  verification_errors: verRow ? verRow.errors_json : null,\n  submitted_at: subRow.submitted_at,\n  completed_at: subRow.completed_at\n}}];\n"
      },
