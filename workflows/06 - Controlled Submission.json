    {
      "parameters": {
        "jsCode": "const submissionGate = $('Submission Gate').first().json;\nconst previewRow = $input.first().json;\n\nif (!previewRow || !previewRow.payload_status) {\n  return [{ json: {\n    status: 'BLOCKED',\n    gate: 'PAYLOAD_GATE',\n    reason: 'NO_PAYLOAD_PREVIEW',\n    request_id: submissionGate.request_id,\n    message: 'No payload preview found for this request. Run Workflow 05 to generate a preview before submitting.'\n  }}];\n}\n\nif (previewRow.payload_status !== 'PREVIEW_ONLY_NOT_SUBMITTED') {\n  return [{ json: {\n    status: 'BLOCKED',\n    gate: 'PAYLOAD_GATE',\n    reason: 'INVALID_PAYLOAD_STATUS',\n    request_id: submissionGate.request_id,\n    message: 'Payload preview status is not valid for submission. Expected PREVIEW_ONLY_NOT_SUBMITTED.',\n    current_status: previewRow.payload_status\n  }}];\n}\n\nlet jsonPayload = null;\ntry {\n  jsonPayload = typeof previewRow.json_payload === 'string'\n    ? JSON.parse(previewRow.json_payload)\n    : previewRow.json_payload;\n} catch(e) {\n  return [{ json: {\n    status: 'BLOCKED',\n    gate: 'PAYLOAD_GATE',\n    reason: 'INVALID_PAYLOAD_JSON',\n    request_id: submissionGate.request_id,\n    message: 'Payload JSON is malformed and cannot be submitted.'\n  }}];\n}\n\nreturn [{ json: {\n  status: 'ALL_GATES_PASSED',\n  request_id: submissionGate.request_id,\n  payload_preview_id: previewRow.id,\n  json_payload: jsonPayload,\n  message: 'All submission gates passed. Ready for feed document creation.',\n  warning: 'ENABLE_LIVE_SUBMISSION is true. Feed will be submitted to Amazon on the next step.'\n}}];"
