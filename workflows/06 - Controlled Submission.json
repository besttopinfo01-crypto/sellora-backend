      "parameters": {
        "jsCode": "const ENABLE_LIVE_SUBMISSION = 'false'; // Change to 'true' ONLY on Day 75\n\nconst body = $input.first().json.body || $input.first().json;\nconst requestId = body.request_id;\n\nif (!requestId) {\n  return [{ json: {\n    status: 'BLOCKED',\n    reason: 'MISSING_REQUEST_ID',\n    message: 'request_id is required to submit a feed.'\n  }}];\n}\n\nif (ENABLE_LIVE_SUBMISSION !== 'true') {\n  return [{ json: {\n    status: 'SUBMISSION_DISABLED',\n    request_id: requestId,\n    message: 'Live submission is disabled. Set ENABLE_LIVE_SUBMISSION to true in the Submission Gate code node only when you are deliberately ready to submit to Amazon.',\n    enable_live_submission_current_value: ENABLE_LIVE_SUBMISSION,\n    action_required: 'Do not change this value unless you have reviewed the payload preview, completed all 4 approval confirmations, and are ready for a controlled live test.'\n  }}];\n}\n\nreturn [{ json: {\n  status: 'GATE_PASSED',\n  request_id: requestId,\n  message: 'ENABLE_LIVE_SUBMISSION is true. Proceeding to submission gates.',\n  warning: 'This will submit a real feed to Amazon. Ensure all gates below pass before proceeding.'\n}}];"
      },
