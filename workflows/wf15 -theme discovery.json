    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const schema = $json;\nconst themeProperty = schema.properties.variation_theme.items.properties.name;\n\nconst validThemes = themeProperty.enum || [];\nconst deprecatedThemes = (themeProperty.$lifecycle && themeProperty.$lifecycle.enumDeprecated) || [];\n\nconst definition = $('Get Product Type Definition').item.json;\n\nreturn {\n  json: {\n    product_type: definition.productType,\n    marketplace_id: definition.marketplaceIds[0],\n    valid_themes: validThemes,\n    deprecated_themes: deprecatedThemes,\n    product_type_version: definition.productTypeVersion.version\n  }\n};"
