        "jsCode": "const sellerRows = $input.first().json;\nconst sellerRow = Array.isArray(sellerRows) ? sellerRows[0] : sellerRows;\nconst ctx = $('Validate Input').first().json;\n\nif (!sellerRow) {\n  return [{ json: { decision: 'REJECTED', reason: 'SELLER_NOT_FOUND', seller_id: ctx.seller_id, message: 'No seller record exists for this seller_id.' } }];\n}\nif (sellerRow.status !== 'active') {\n  return [{ json: { decision: 'REJECTED', reason: 'SELLER_NOT_ACTIVE', seller_id: ctx.seller_id, seller_status: sellerRow.status, message: 'This seller account is not active (status: ' + sellerRow.status + '). Access is not permitted.' } }];\n}\n\nreturn [{ json: { decision: 'ELIGIBLE', seller_id: ctx.seller_id } }];"
