    {
      "parameters": {
        "jsCode": "function collectAll(nodeItems) {\n  // n8n may return a PostgREST array response as ONE item containing the\n  // array, or split it into one item per row - handle both. Same defensive\n  // pattern already used in wf14's Fetch Items node; missed reusing it here\n  // the first time, which is exactly why Fetch Merge Requests' real 4 rows\n  // never reached this node's output correctly.\n  if (nodeItems.length === 1 && Array.isArray(nodeItems[0].json)) {\n    return nodeItems[0].json;\n  }\n  return nodeItems.map(function(i) { return i.json; });\n}\n\nconst ctx = $('Validate Input').first().json;\nconst requests = collectAll($('Fetch Merge Requests').all());\nconst items = collectAll($input.all());\n\n// Group items by request_id for child-count and parent_sku lookup.\nconst itemsByRequest = {};\nitems.forEach(function(item) {\n  if (!itemsByRequest[item.request_id]) itemsByRequest[item.request_id] = [];\n  itemsByRequest[item.request_id].push(item);\n});\n\nconst rows = requests.map(function(req) {\n  const reqItems = itemsByRequest[req.request_id] || [];\n\n  // OPEN QUESTION (still unconfirmed): 'parentage' column's real values are\n  // unknown - may distinguish parent-rows from child-rows within this same\n  // table. For now this counts ALL item rows for the request. Revisit once\n  // real data lets you check `select distinct parentage from merge_request_items`.\n  const childCount = reqItems.length;\n\n  const parentSkuItem = reqItems.find(function(i) { return i.parent_sku; });\n\n  return {\n    request_id: req.request_id,\n    status: req.status,\n    merge_type: req.merge_type,\n    marketplace_id: req.marketplace_id,\n    parent_sku: parentSkuItem ? parentSkuItem.parent_sku : null,\n    child_count: childCount,\n    dimension1_theme: req.dimension1_theme,\n    dimension2_theme: req.dimension2_theme || null,\n    created_at: req.created_at\n  };\n});\n\nreturn [{ json: {\n  decision: 'DASHBOARD_READY',\n  seller_id: ctx.seller_id,\n  count: rows.length,\n  requests: rows\n}}];"
      },
