    {
      "parameters": {
        "jsCode": "const submitted = $input.first().json;\nconst results = submitted.results || [];\n\nconst allVerified = results.length > 0 && results.every(function(r) { return r.verified_child; });\nconst noneVerified = results.every(function(r) { return !r.verified_child; });\n\n// Matches dashboard.jsx's existing status vocabulary on purpose - the\n// same words this app already shows for the Feeds pipeline's outcome,\n// so the user sees consistent language regardless of which mechanism\n// actually ran underneath.\nconst finalStatus = allVerified ? 'verified' : (noneVerified ? 'failed' : 'partially_failed');\n\nreturn [{ json: {\n  decision: 'SUMMARIZED',\n  request_id: submitted.request_id,\n  final_status: finalStatus,\n  child_count: results.length,\n  verified_count: results.filter(function(r) { return r.verified_child; }).length,\n  results: results\n}}];"
