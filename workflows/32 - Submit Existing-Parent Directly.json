    {
      "parameters": {
        "jsCode": "const claimed = $('Check Claim Succeeded').first().json;\nconst sellingPartnerRaw = $('Get Seller Selling Partner ID').first().json;\nconst sellingPartnerRow = Array.isArray(sellingPartnerRaw) ? sellingPartnerRaw[0] : sellingPartnerRaw;\nconst sellingPartnerId = sellingPartnerRow && sellingPartnerRow.selling_partner_id;\nconst accessToken = $('Exchange for Access Token').first().json.access_token;\n\nif (!sellingPartnerId || !accessToken) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'MISSING_CREDENTIALS', request_id: claimed.request_id,\n    message: 'Could not resolve a selling_partner_id or access_token before submitting - refusing to attempt any real calls without both.'\n  }}];\n}\n\nconst results = [];\n\n// Phase 1: patch every child first, without verifying yet. Separated\n// from verification on purpose - see phase 2's comment for why.\nfor (const msg of claimed.messages) {\n  const entry = { sku: msg.sku, patch_status: null, patch_issues: [], verified_child: false, verify_issues: [], verify_attempts: 0, error: null };\n\n  try {\n    const patchResponse = await this.helpers.httpRequest({\n      method: 'PATCH',\n      url: 'https://sellingpartnerapi-na.amazon.com/listings/2021-08-01/items/' + sellingPartnerId + '/' + encodeURIComponent(msg.sku),\n      qs: { marketplaceIds: claimed.marketplace_id, issueLocale: 'en_US' },\n      headers: { 'Content-Type': 'application/json', 'x-amz-access-token': accessToken },\n      body: { productType: msg.productType, patches: msg.patches },\n      json: true\n    });\n    entry.patch_status = patchResponse.status || null;\n    entry.patch_issues = patchResponse.issues || [];\n  } catch (err) {\n    entry.error = 'patch call failed: ' + (err.message || String(err));\n  }\n\n  results.push(entry);\n}\n\n// Phase 2: verify every child, with a shared wait-and-retry schedule -\n// found necessary from a real run today, not a hypothetical: a genuine\n// merge showed verified_child=false on the very first check right after\n// patching, then true a few minutes later once Amazon's own downstream\n// processing had actually caught up. One immediate check isn't\n// reliable. Waiting together, once per round, rather than each child\n// running its own full retry sequence independently, keeps the total\n// added time roughly constant regardless of how many children there are.\n// Stops early the moment everything's confirmed or every remaining\n// entry has hit a real error - no point waiting out the full schedule\n// once there's nothing left to check.\nconst verifyDelaysMs = [3000, 5000, 7000, 10000, 15000]; // ~40s max total extra wait, shared\nfor (let attempt = 0; attempt <= verifyDelaysMs.length; attempt++) {\n  if (attempt > 0) {\n    await new Promise(function(resolve) { setTimeout(resolve, verifyDelaysMs[attempt - 1]); });\n  }\n\n  const stillPending = results.filter(function(r) { return !r.verified_child && !r.error; });\n  if (stillPending.length === 0) break;\n\n  for (const entry of stillPending) {\n    entry.verify_attempts++;\n    try {\n      const stateResponse = await this.helpers.httpRequest({\n        method: 'GET',\n        url: 'https://sellingpartnerapi-na.amazon.com/listings/2021-08-01/items/' + sellingPartnerId + '/' + encodeURIComponent(entry.sku),\n        qs: { marketplaceIds: claimed.marketplace_id, includedData: 'attributes,issues' },\n        headers: { 'x-amz-access-token': accessToken },\n        json: true\n      });\n      const attrs = stateResponse.attributes || {};\n      entry.verified_child = !!(attrs.parentage_level && attrs.parentage_level.some(function(e) { return e.value === 'child'; }));\n      entry.verify_issues = stateResponse.issues || [];\n    } catch (err) {\n      entry.error = 'verify call failed: ' + (err.message || String(err));\n    }\n  }\n}\n\nreturn [{ json: {\n  decision: 'SUBMITTED',\n  request_id: claimed.request_id,\n  results: results\n}}];"
      },
