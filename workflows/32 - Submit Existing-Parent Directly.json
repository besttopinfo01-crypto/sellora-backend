    {
      "parameters": {
        "jsCode": "const validated = $('Validate Input').first().json;\n\nconst approvalRaw = $('Fetch Approval Log').first().json;\nconst approvalRow = Array.isArray(approvalRaw) ? approvalRaw[0] : approvalRaw;\n\nconst mergeRaw = $('Fetch Merge Request').first().json;\nconst mergeRow = Array.isArray(mergeRaw) ? mergeRaw[0] : mergeRaw;\n\nif (!approvalRow || approvalRow.approval_status !== 'approved' || !approvalRow.staged_payload_json) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'NOT_APPROVED', request_id: validated.request_id,\n    message: 'No approved, staged payload found for this request_id.'\n  }}];\n}\n\nif (!mergeRow) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'MERGE_REQUEST_NOT_FOUND', request_id: validated.request_id,\n    message: 'No merge_requests row found for this request_id.'\n  }}];\n}\n\n// This path is only for existing-parent merges - it patches each child\n// independently, which only makes sense when the parent already exists.\n// A brand-new parent and its children need to come into existence\n// together as one operation, which this deliberately cannot do -\n// wf30 (the Feeds pipeline) is still the only path for that mode.\nif (mergeRow.is_new_parent) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'WRONG_MODE', request_id: validated.request_id,\n    message: 'This is a new-parent merge - the direct API path only supports existing-parent merges. Use wf30 instead.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'READY',\n  request_id: validated.request_id,\n  seller_id: mergeRow.seller_id,\n  marketplace_id: mergeRow.marketplace_id,\n  messages: approvalRow.staged_payload_json.messages || []\n}}];"
