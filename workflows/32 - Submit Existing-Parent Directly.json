      "parameters": {
        "jsCode": "const ready = $('Check Ready To Submit').first().json;\nconst upstream = $input.first().json;\nconst rows = Array.isArray(upstream) ? upstream : (upstream && upstream.request_id ? [upstream] : []);\n\nif (rows.length === 0) {\n  return [{ json: {\n    decision: 'REJECTED', reason: 'CLAIM_LOST', request_id: ready.request_id,\n    message: 'Could not claim this submission - another request may have already claimed it between the ready-check and now. Refusing rather than risk a duplicate.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'CLAIMED',\n  request_id: ready.request_id,\n  seller_id: ready.seller_id,\n  marketplace_id: ready.marketplace_id,\n  messages: ready.messages\n}}];"
