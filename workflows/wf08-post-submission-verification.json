        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"asin\": \"{{ $('Fetch Submission Items').item.json.asin }}\",\n  \"marketplace_id\": \"ATVPDKIKX0DER\",\n  \"brand\": \"{{ $('Fetch Submission Items').item.json.normalized_brand }}\"\n}",
