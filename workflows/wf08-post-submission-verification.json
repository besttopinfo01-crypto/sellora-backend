      "name": "Fetch Catalog Data for Verification",
      "alwaysOutputData": true,
      "executeOnce": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const validateInput = $('Validate Input').first().json;\nconst catalogItems = $input.all().map(function(i) { return i.json; });\nconst submissionItems = $('Fetch Submission Items').all().map(function(i) { return i.json; });\n\nconst itemResults = catalogItems.map(function(catalogData) {\n  const matchingSubmissionItem = submissionItems.find(function(s) {\n    return s.asin === catalogData.asin;\n  }) || {};\n\n  const expectedParentSku = matchingSubmissionItem.parent_sku || null;\n  const relationships = catalogData.relationships || [];\n\n  const isVerified = relationships.some(function(rel) {\n    return rel.type === 'variation_child' && rel.parentAsins && rel.parentAsins.length > 0;\n  });\n\n  return {\n    asin: catalogData.asin,\n    sku: matchingSubmissionItem.sku || null,\n    expected_parent_sku: expectedParentSku,\n    relationships_found: relationships,\n    relationship_count: relationships.length,\n    is_verified: isVerified\n  };\n});\n\nconst allVerified = itemResults.length > 0 && itemResults.every(function(r) { return r.is_verified; });\nconst verificationStatus = allVerified ? 'verified_success' : 'unverified_manual_review';\nconst failedItems = itemResults.filter(function(r) { return !r.is_verified; });\n\nconst errors = failedItems.map(function(item) {\n  return {\n    asin: item.asin,\n    sku: item.sku,\n    message: 'Variation relationship not confirmed in Amazon catalog after feed processing for this ASIN.',\n    action: 'Wait 15 more minutes and check Seller Central manually. If still not showing, open a Seller Support case.',\n    needs_seller_support: true\n  };\n});\n\nreturn [{ json: {\n  request_id: validateInput.request_id,\n  feed_id: validateInput.feed_id,\n  verification_status: verificationStatus,\n  expected_result: {\n    request_id: validateInput.request_id,\n    expected_relationship_type: 'variation_child',\n    total_items_expected: submissionItems.length\n  },\n  actual_result: {\n    items_checked: itemResults.length,\n    items_verified: itemResults.length - failedItems.length,\n    item_results: itemResults\n  },\n  errors: errors,\n  verified_at: $now.toISO()\n}}];"
      },
