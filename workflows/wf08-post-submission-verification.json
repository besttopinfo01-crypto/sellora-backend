    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst requestId = body.request_id;\nconst feedId = body.feed_id;\n\nif (!requestId || !feedId) {\n  return [{ json: {\n    status: 'BLOCKED',\n    reason: 'MISSING_REQUIRED_FIELDS',\n    message: 'request_id and feed_id are required to run post-submission verification.'\n  }}];\n}\n\nreturn [{ json: {\n  request_id: requestId,\n  feed_id: feedId,\n  verification_started_at: $now.toISO()\n}}];"
      },
