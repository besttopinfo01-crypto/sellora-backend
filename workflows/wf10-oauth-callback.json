    {
      "parameters": {
        "jsCode": "// Ready for Day 9: seller_id, selling_partner_id, and spapi_oauth_code\n// are all we need to actually exchange the code for a refresh token.\n// Not built yet on purpose - the exchange is tomorrow's piece, and the\n// spapi_oauth_code expires in 5 minutes, so whatever runs next needs\n// to fire immediately once this is wired up, not sit queued.\nconst validated = $('Validate State').first().json;\nreturn [{ json: {\n  seller_id: validated.seller_id,\n  selling_partner_id: validated.selling_partner_id,\n  spapi_oauth_code: validated.spapi_oauth_code,\n  ready_for_token_exchange: true\n}}];"
