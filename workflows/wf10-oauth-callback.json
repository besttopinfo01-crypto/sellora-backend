      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst message = data.message || 'Something went wrong. Please start over from Connect Amazon Account.';\n\nconst html = `<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Connection unsuccessful</title>\n<style>\nbody { font-family: -apple-system, sans-serif; max-width: 480px; margin: 80px auto; padding: 0 20px; color: #1a1a1a; text-align: center; }\nh1 { font-size: 20px; }\np { color: #555; line-height: 1.5; }\na.button { display: inline-block; margin-top: 24px; padding: 12px 24px; background: #232f3e; color: white; text-decoration: none; border-radius: 4px; }\n</style>\n</head>\n<body>\n<h1>We couldn't connect your Amazon account</h1>\n<p>${message}</p>\n<a class=\"button\" href=\"https://app.catalove.ai/?connected=false\">Try again</a>\n</body>\n</html>`;\n\nreturn [{ json: { html } }];"
