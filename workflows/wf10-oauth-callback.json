    {
      "parameters": {
        "jsCode": "const ctx = $('Resolve Existing Or New').first().json;\n\n// Same throwaway-password pattern as the original signup flow (wf41)\n// - sent once to the admin create-user call below and never stored,\n// shown, or needed again.\nfunction randomPassword(len) {\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@#$%';\n  let out = '';\n  for (let i = 0; i < len; i++) {\n    out += chars[Math.floor(Math.random() * chars.length)];\n  }\n  return out;\n}\n\n// Placeholder, not a real inbox: this seller connected Amazon straight\n// from the landing-page button, without typing an email first.\n// auth.users still needs *some* unique email for the admin create-user\n// call, so this generates one that's obviously not real and easy to\n// find later (LIKE '%@connect.catalove.internal') - wf22's own\n// needs_email check looks for this exact domain. It's never shown to\n// the seller; the dashboard's \"add your email\" prompt (wired to the\n// repurposed wf41) is what turns this into a real, reachable address.\nfunction randomToken() {\n  return Math.random().toString(36).slice(2) + Date.now().toString(36);\n}\nconst placeholderEmail = 'pending-' + randomToken() + '@connect.catalove.internal';\n\nreturn [{ json: {\n  selling_partner_id: ctx.selling_partner_id,\n  spapi_oauth_code: ctx.spapi_oauth_code,\n  contact_email: placeholderEmail,\n  throwaway_password: randomPassword(24)\n}}];"
      },
