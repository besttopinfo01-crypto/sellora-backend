      "parameters": {
        "jsCode": "const ctx = $('Extract Seller Email').first().json;\nconst res = $input.first().json;\n\n// The raw REST response for generate_link hasn't been confirmed\n// against this project's own Supabase instance yet - the JS SDK's\n// own wrapper nests this under .properties.hashed_token, but a raw\n// HTTP call (what this node makes) may return hashed_token at the\n// top level instead. Checked defensively both ways rather than\n// assumed, same as every other admin-API response in this workflow.\nconst hashedToken = (res && res.hashed_token)\n  ? res.hashed_token\n  : ((res && res.properties && res.properties.hashed_token) ? res.properties.hashed_token : null);\n\nif (!hashedToken) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'TOKEN_GENERATION_FAILED',\n    message: 'Connected, but something went wrong finishing sign-in. Please try again from Connect Amazon Account.'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'TOKEN_READY',\n  seller_id: ctx.seller_id,\n  hashed_token: hashedToken\n}}];"
