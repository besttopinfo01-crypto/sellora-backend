    {
      "parameters": {
        "jsCode": "// Same empty-array-vs-placeholder awareness as wf21's original fix:\n// alwaysOutputData can force a single {} through where PostgREST\n// would otherwise return zero rows, so an object with no keys is\n// treated the same as a genuinely empty array, not as a match.\nconst ctx = $('Check Seller ID Presence').first().json;\nconst items = $input.all();\nlet row = null;\nif (items.length > 0) {\n  const data = items[0].json;\n  if (Array.isArray(data)) {\n    row = data.length > 0 ? data[0] : null;\n  } else if (data && typeof data === 'object' && Object.keys(data).length > 0) {\n    row = data;\n  }\n}\n\nif (row && row.seller_id) {\n  return [{ json: {\n    decision: 'REUSE_EXISTING',\n    seller_id: row.seller_id,\n    selling_partner_id: ctx.selling_partner_id,\n    spapi_oauth_code: ctx.spapi_oauth_code\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'CREATE_NEW',\n  selling_partner_id: ctx.selling_partner_id,\n  spapi_oauth_code: ctx.spapi_oauth_code\n}}];"
