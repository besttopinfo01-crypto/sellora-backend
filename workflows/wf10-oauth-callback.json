      "parameters": {
        "jsCode": "const params = $('Extract Query Params').first().json;\n\n// Fetch OAuth State's own output confirms this arrives as a bare row\n// object when a match is found, not the raw PostgREST array — so\n// Array.isArray() here was always false, silently treating every real,\n// unused, unexpired state as \"not found.\" Check items.length instead,\n// which correctly reflects zero vs. one item either way.\nconst items = $input.all();\nlet row = null;\nif (items.length > 0) {\n  const data = items[0].json;\n  row = Array.isArray(data) ? data[0] : data;\n}\n\n// A row that exists but has a null seller_id is what wf09 stores for\n// a brand-new visitor with no seller_id yet (see wf09's own comment on\n// this) - that's a valid, expected shape now, not an error. Only a\n// genuinely missing row means the state itself was never issued.\nif (!row) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'UNKNOWN_STATE',\n    message: 'This authorization attempt was not recognized. Please start over from Connect Amazon Account.'\n  }}];\n}\nif (row.used_at) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'STATE_ALREADY_USED',\n    message: 'This authorization link has already been used. Please start over from Connect Amazon Account.'\n  }}];\n}\n// Basic staleness check here; Day 10 builds the full, user-facing\n// clean-restart handling for this specific case in more detail.\nconst ageMinutes = (Date.now() - new Date(row.created_at).getTime()) / 60000;\nif (ageMinutes > 10) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'STATE_EXPIRED',\n    message: 'This authorization attempt took too long and expired. Please start over from Connect Amazon Account.',\n    age_minutes: ageMinutes\n  }}];\n}\nreturn [{ json: {\n  decision: 'VALID',\n  seller_id: row.seller_id,\n  state: params.state,\n  selling_partner_id: params.selling_partner_id,\n  spapi_oauth_code: params.spapi_oauth_code\n}}];"
      },
