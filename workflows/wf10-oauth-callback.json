      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst q = raw.query ? raw.query : raw;\n\nconst state = q.state;\nconst sellingPartnerId = q.selling_partner_id;\nconst spapiOauthCode = q.spapi_oauth_code;\n\nif (!state || !sellingPartnerId || !spapiOauthCode) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MISSING_REQUIRED_PARAMS',\n    message: 'Amazon did not return one or more required parameters (state, selling_partner_id, spapi_oauth_code).'\n  }}];\n}\n\nreturn [{ json: {\n  decision: 'HAS_PARAMS',\n  state: state,\n  selling_partner_id: sellingPartnerId,\n  spapi_oauth_code: spapiOauthCode,\n  received_at: $now.toISO()\n}}];"
      },
