        "jsCode": "const ctx = $('Check Token Generated').first().json;\n\n// type=email (not magiclink) is deliberate - that's what generated\n// the token, but supabase-js's verifyOtp call on the other end\n// needs 'email' as the type for an email-based token_hash, confirmed\n// against Supabase's own documented examples of this exact\n// generate-then-verify pattern before relying on it.\nconst url = 'https://app.catalove.ai/auth/callback'\n  + '?token_hash=' + encodeURIComponent(ctx.hashed_token)\n  + '&type=email'\n  + '&connected=true'\n  + '&seller_id=' + encodeURIComponent(ctx.seller_id);\n\nreturn [{ json: { redirect_url: url } }];"
