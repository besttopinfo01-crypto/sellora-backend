    {
      "parameters": {
        "jsCode": "const fetched = $input.first().json;\nconst row = Array.isArray(fetched) ? fetched[0] : fetched;\nconst ctx = $('Validate Input').first().json;\n\nif (!row || !row.request_id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MERGE_REQUEST_NOT_FOUND',\n    request_id: ctx.request_id,\n    message: 'No merge_requests row found for this request_id.'\n  }}];\n}\n\n// Genuine delete only ever runs for a request that never got past draft -\n// re-checked here against the real row, not just trusted from whichever\n// button the frontend happened to show (same belt-and-suspenders reasoning\n// wf28's own confirmations re-check already documents). Anything past\n// draft has already been logged (approval_logs) or, further along,\n// actually submitted to Amazon (submission_logs) - deleting the local row\n// at that point would hide real history without undoing anything real on\n// Amazon's side, which is exactly the case archive exists for instead.\nif (row.status !== 'draft') {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'NOT_A_DRAFT',\n    request_id: row.request_id,\n    status: row.status,\n    message: 'Only requests still at draft can be permanently deleted (current status: ' + row.status + '). Use archive instead.'\n  }}];\n}\n\nreturn [{ json: { decision: 'IS_DRAFT', request_id: row.request_id } }];"
      },
