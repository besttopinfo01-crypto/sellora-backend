    {
      "parameters": {
        "jsCode": "const ctx = $('Check Is Draft').first().json;\nconst rawItems = $input.all();\n\n// Same \"one item containing the whole array, or one item per row\"\n// ambiguity already documented and handled elsewhere in this project\n// (wf14/wf21's collectAll) - plus a third shape specific to a genuinely\n// empty PostgREST result ([]): a single item whose json is an empty\n// placeholder object {} rather than an array at all. All three are\n// confirmed real, not theoretical - the third is exactly what caused a\n// false SUBMISSION_LOG_EXISTS rejection on a genuinely clean draft,\n// confirmed independently via direct SQL against submission_logs\n// returning zero rows for the same request_id.\nlet rows;\nif (rawItems.length === 1 && Array.isArray(rawItems[0].json)) {\n  rows = rawItems[0].json;\n} else {\n  rows = rawItems\n    .map(function(i) { return i.json; })\n    .filter(function(j) { return j && typeof j === 'object' && !Array.isArray(j) && Object.keys(j).length > 0; });\n}\n\n// Checking for a real `id` specifically (the one field this query\n// actually selects), not just \"is there a row-shaped object at all\" -\n// belt and suspenders on top of the empty-object filter above.\nconst hasRealSubmissionLog = rows.some(function(r) {\n  return r && r.id !== undefined && r.id !== null;\n});\n\nif (hasRealSubmissionLog) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'SUBMISSION_LOG_EXISTS',\n    request_id: ctx.request_id,\n    message: 'A submission log exists for this request despite its draft status - this is unexpected and worth checking directly before deleting anything.'\n  }}];\n}\n\nreturn [{ json: { decision: 'SAFE_TO_DELETE', request_id: ctx.request_id } }];"
      },
