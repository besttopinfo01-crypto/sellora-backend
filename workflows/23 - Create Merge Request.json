    {
      "parameters": {
        "jsCode": "const inserted = $input.first().json;\nconst mergeRequestRow = Array.isArray(inserted) ? inserted[0] : inserted;\n\nif (!mergeRequestRow || !mergeRequestRow.request_id) {\n  return [{ json: {\n    decision: 'REJECTED',\n    reason: 'MERGE_REQUEST_INSERT_FAILED',\n    message: 'The merge_requests insert did not return a request_id.',\n    upstream_raw: inserted\n  }}];\n}\n\nconst ctx = $('Validate Input').first().json;\nconst requestId = mergeRequestRow.request_id;\n\nconst itemRows = ctx.items.map(function(item) {\n  return {\n    request_id: requestId,\n    seller_id: ctx.seller_id,\n    asin: item.asin,\n    sku: item.sku,\n    parent_sku: item.parent_sku || null,\n    dimension1_value: item.dimension1_value,\n    dimension2_value: item.dimension2_value || null,\n    normalized_brand: item.normalized_brand || null,\n    normalized_product_type: item.normalized_product_type || null,\n    normalized_category: item.normalized_category || null\n  };\n});\n\nreturn [{ json: {\n  decision: 'VALID',\n  request_id: requestId,\n  item_rows: itemRows\n}}];"
