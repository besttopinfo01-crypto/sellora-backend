    {
      "parameters": {
        "jsCode": "const rawInput = $input.first().json;\nconst body = rawInput.body ? rawInput.body : rawInput;\n\nif (!body.seller_id) {\n  return [{ json: { decision: 'REJECTED', reason: 'MISSING_SELLER_ID', message: 'seller_id is required.' } }];\n}\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(body.seller_id)) {\n  return [{ json: { decision: 'REJECTED', reason: 'INVALID_SELLER_ID_FORMAT', message: 'seller_id must be a valid UUID.' } }];\n}\nif (!body.dimension1_theme || !body.dimension1_attribute) {\n  return [{ json: { decision: 'REJECTED', reason: 'MISSING_REQUIRED_FIELDS', message: 'dimension1_theme and dimension1_attribute are both required.' } }];\n}\nif (!Array.isArray(body.items) || body.items.length === 0) {\n  return [{ json: { decision: 'REJECTED', reason: 'MISSING_ITEMS', message: 'items must be a non-empty array.' } }];\n}\nconst itemErrors = [];\nbody.items.forEach(function(item, i) {\n  if (!item.asin) itemErrors.push('items[' + i + '].asin');\n  if (!item.sku) itemErrors.push('items[' + i + '].sku');\n  if (!item.dimension1_value) itemErrors.push('items[' + i + '].dimension1_value');\n});\nif (itemErrors.length > 0) {\n  return [{ json: { decision: 'REJECTED', reason: 'INVALID_ITEMS', message: 'Missing or invalid: ' + itemErrors.join(', ') + '.' } }];\n}\n\nreturn [{ json: {\n  decision: 'VALID',\n  seller_id: body.seller_id,\n  marketplace_id: body.marketplace_id || null,\n  merge_type: body.dimension2_theme ? 'matrix' : 'single',\n  dimension1_theme: body.dimension1_theme,\n  dimension1_attribute: body.dimension1_attribute,\n  dimension2_theme: body.dimension2_theme || null,\n  dimension2_attribute: body.dimension2_attribute || null,\n  items: body.items\n}}];\n"
      },
